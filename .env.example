# Copie este archivo a .env con:  ./scripts/generar_env.sh
# (el script reemplaza los valores CAMBIAR_* por claves aleatorias y deja .env con permisos 600)
# .env NUNCA se sube al repositorio (está en .gitignore).

POSTGRES_DB=agroanalisis
POSTGRES_USER=agro_app
POSTGRES_PASSWORD=CAMBIAR_DB

SECRET_KEY=CAMBIAR_SECRET

# Administrador inicial (se crea solo si no existe ningún admin)
ADMIN_USER=coordinador
ADMIN_PASSWORD=CAMBIAR_ADMIN

# Clave de las cuentas de demostración: tecnico1, agricultor1, agricultor2
DEMO_PASSWORD=CAMBIAR_DEMO

# Política de archivos y regla de negocio
MAX_MB=2
MAX_ACTIVOS_USUARIO=3

# Segundos de pausa por trabajo para poder ver el estado "en_ejecucion" en la demo
PROCESAMIENTO_DEMORA_S=3

# Poner en 1 si se configura HTTPS
COOKIE_SECURE=0
