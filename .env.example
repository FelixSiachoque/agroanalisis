# Copie este archivo a .env con:  ./scripts/generar_env.sh
# (el script reemplaza los valores CAMBIAR_* por claves aleatorias y deja .env con permisos 600)
# .env NUNCA se sube al repositorio (está en .gitignore).

# ---------------------------------------------------------------- base de datos
POSTGRES_DB=agroanalisis
# Superusuario de PostgreSQL: SOLO lo usa el contenedor db (esquema y migraciones).
POSTGRES_USER=agro_admin
POSTGRES_PASSWORD=CAMBIAR_DB
# Usuarios de mínimo privilegio (db/roles.sql): agro_web (app) y agro_worker (worker)
APP_DB_PASSWORD=CAMBIAR_APPDB
WORKER_DB_PASSWORD=CAMBIAR_WORKERDB

# ---------------------------------------------------------------- aplicación
SECRET_KEY=CAMBIAR_SECRET
# Poner en 1 solo si se configura HTTPS (la cookie viajaría solo cifrada)
COOKIE_SECURE=0

# Administrador inicial (se crea solo si no existe ningún admin)
ADMIN_USER=coordinador
ADMIN_PASSWORD=CAMBIAR_ADMIN

# Clave de las cuentas de demostración: tecnico1, agricultor1, agricultor2
DEMO_PASSWORD=CAMBIAR_DEMO

# Política técnica de archivos (validacion.py)
MAX_MB=2

# ---------------------------------------------------------------- reglas de negocio (app/reglas_negocio.py)
# Parámetros:
MAX_ACTIVOS_USUARIO=3
# CABECERA_CSV=lote_id,fecha,medicion
#
# Encender (1) o apagar (0) una regla SIN reconstruir la imagen (luego: docker compose up -d app).
# Vacío o comentado = se usa el valor "activa" escrito en reglas_negocio.py.
# REGLA_CUOTA_TRABAJOS_ACTIVOS=1
# REGLA_BLOQUEAR_BORRADO_FINALIZADOS=1
# REGLA_CABECERA_CSV_OBLIGATORIA=0
# REGLA_RANGOS_AGRONOMICOS_VALIDOS=0
# REGLA_TAMANO_MAXIMO_POR_ROL=0
# REGLA_VENTANA_RECEPCION=0
# REGLA_BLOQUEAR_DESCARGA_ORIGINALES_AJENOS=0
# REGLA_TRABAJOS_CONFIDENCIALES=0
# REGLA_LIMITE_REPROCESOS=0

# ---------------------------------------------------------------- worker
# Segundos de pausa por trabajo para poder ver el estado "en_ejecucion" en la demo
PROCESAMIENTO_DEMORA_S=3
# Veces que un trabajo puede interrumpirse (worker caído) antes de marcarlo fallido
MAX_INTENTOS=3
# Tiempo máximo de procesamiento de un trabajo (segundos)
TIMEOUT_TRABAJO_S=120
# Un worker sin latido durante este tiempo se considera caído y sus trabajos se recuperan
LATIDO_CADUCO_S=60
